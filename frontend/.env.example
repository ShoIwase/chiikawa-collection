# API Gateway エンドポイント (terraform output chiikawa_api_endpoint の値)
NEXT_PUBLIC_API_URL=https://xxxxxxxxxx.execute-api.ap-northeast-1.amazonaws.com

# Cognito User Pool ID (ap-northeast-1_xP4qySxtH)
NEXT_PUBLIC_COGNITO_USER_POOL_ID=ap-northeast-1_xP4qySxtH

# Cognito App Client ID (terraform output chiikawa_cognito_client_id の値)
NEXT_PUBLIC_COGNITO_CLIENT_ID=

# CloudFront URL (terraform output chiikawa_cloudfront_url の値, 末尾スラッシュなし)
NEXT_PUBLIC_CLOUDFRONT_URL=https://chiikawa.example.com
