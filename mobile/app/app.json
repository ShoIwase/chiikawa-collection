{
  "expo": {
    "name": "app",
    "slug": "app",
    "owner": "shoiwase",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "net.bar504.chiikawa"
    },
    "android": {
      "package": "net.bar504.chiikawa",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "cameraPermission": "キーホルダーを撮影してスキャンするために使用します。",
          "photoLibraryPermission": "保存済みの写真からスキャンするために使用します。"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "419249ff-4645-4219-994b-9ae4d1a296de"
      }
    }
  }
}
